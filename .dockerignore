# Version control
.git
.gitignore
.github

# IDEs and local editor directories
.gemini
.cursor
.vscode
.idea
.opencode
.claude
.kiro
.continue
.agents
.banyancode
.pi

# Local build artifacts and outputs
artifacts/
# bazel-* also matches bazel-distdir/, which build.sh's offline mode needs
# to COPY into the image (Dockerfile.ubuntu) — un-ignore it explicitly.
bazel-*
!bazel-distdir/
!bazel-distdir/**
!build_files.tar
!build_files.txt

# OS-generated metadata (placed after !bazel-distdir/** so they remain ignored inside it)
.DS_Store
**/.DS_Store
._*
**/._*

# Python caches, virtualenvs, and bytecode
.venv/
venv/
**/__pycache__/
*.pyc
*.pyo

# Local shadow index, symbol cache, and assistant configs
graft/
.tgrep/
.codex/
.aiderignore
.ignore
.mcp.json
CLAUDE.md
AGENTS.md
GEMINI.md

# Documentation, notices, and host scripts
docs/
THIRD_PARTY_NOTICES.txt
README.md
CONTRIBUTING.md
CONVENTIONS.md
SECURITY.md
build.sh
fetch_workspace_deps.sh

# Non-build directories and CI configs
openspec/
build/kokoro/

# Tests not needed for build
tests/client_matrix/
tests/image_verification_test.py

# Temporary files and logs
*.tmp
**/*.log
node_modules/
**/node_modules/


