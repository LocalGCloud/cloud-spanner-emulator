# Version control
.git
.gitignore
.github

# IDEs and local editor directories
.gemini
.cursor
.vscode
.idea
.opencode
.claude
.kiro
.continue
.agents
.banyancode
.pi

# Local build artifacts and outputs
artifacts/
# bazel-* also matches bazel-distdir/, which build.sh's offline mode needs
# to COPY into the image (Dockerfile.ubuntu) — un-ignore it explicitly.
bazel-*
!bazel-distdir/
!bazel-distdir/**
!build_files.tar
!build_files.txt

# OS-generated metadata (placed after !bazel-distdir/** so they remain ignored inside it)
.DS_Store
**/.DS_Store
._*
**/._*

# Local shadow index, symbol cache, and assistant configs
graft/
.tgrep/
.codex/
.aiderignore
.ignore

# Documentation and non-build test fixtures
docs/
tests/client_matrix/

# Python caches and bytecode
**/__pycache__/
*.pyc
*.pyo

# Temporary files and logs
*.tmp
**/*.log
node_modules/
**/node_modules/
