# Version control
.git
.gitignore
.github

# IDEs and local editor directories
.gemini
.cursor
.vscode
.idea
.opencode
.claude
.kiro
.continue
.agents
.banyancode
.pi

# Local build artifacts and outputs
artifacts/
# bazel-* also matches bazel-distdir/, which build.sh's offline mode needs
# to COPY into the image (Dockerfile.ubuntu) — un-ignore it explicitly.
bazel-*
!bazel-distdir/
!bazel-distdir/**
!build_files.tar
!build_files.txt

# Temporary files and logs
*.tmp
*.log
node_modules/
