build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# gRPC has some issues with building under bazel on MacOS with thread-locals.
# See https://github.com/bazelbuild/bazel/issues/4341 for more details. This
# flag enabled gRPC workarounds for building under bazel.
build --copt -DGRPC_BAZEL_BUILD

# Disable debug symbols for release builds.
build --copt -DNDEBUG

# Required for python test runner to find gcloud binary.
test --test_env GCLOUD_DIR

# Most of these warnings are triggered from ZetaSQL, disable for now. Ideally,
# we would disable these only for projects we don't control, but there does not
# seem to be an easy way to do that yet.
build --copt   -Wno-sign-compare
build --copt   -Wno-deprecated-declarations
build --copt   -Wno-return-type
build --copt   -Wno-unused-but-set-parameter

# Reduce optimization on ALL external C++ deps.
# ZetaSQL, ICU, gRPC, protobuf compile 2-4x faster at -O1 vs -O3.
# This is a dev emulator — runtime perf of these deps is irrelevant.
# Bazel 6 per_file_copt matches source-relative paths (not execroot paths),
# so patterns use repo-relative paths like zetasql/... not external/com_google_zetasql/...
build --per_file_copt=+.*zetasql/.*\.cc@-O1
build --per_file_copt=+.*com_google_icu/.*\.c@-O1
build --per_file_copt=+.*com_google_icu/.*\.cc@-O1
build --per_file_copt=+.*grpc/.*\.cc@-O1
build --per_file_copt=+.*com_google_protobuf/.*\.cc@-O1

# ZetaSQL rewriter/visitor files are the worst offenders — even -O1 uses ~2GB.
# Drop to -O0 so they compile in seconds with minimal RAM.
# -O0 is applied AFTER -O1 (last flag wins in GCC), so these override the
# blanket -O1 rule above for these specific files.
build --per_file_copt=+.*resolved_ast_rewrite_visitor.*\.cc@-O0
build --per_file_copt=+.*resolved_ast_deep_copy_visitor.*\.cc@-O0
build --per_file_copt=+.*generalized_query_stmt_rewriter.*\.cc@-O0
build --per_file_copt=+.*rewrite_subpipeline.*\.cc@-O0
build --per_file_copt=+.*order_by_and_limit_in_aggregate_rewriter.*\.cc@-O0
build --per_file_copt=+.*resolved_ast\.cc@-O0

# Guard against concurrent cache corruption
build --experimental_guard_against_concurrent_changes

# Shut down Bazel server promptly after build finishes. In Docker, the
# persisted output base must be unlocked so the next docker build can
# acquire the lock. The default 10800s (3h) leaves a stale lock when a
# container exits.
startup --max_idle_secs=60
