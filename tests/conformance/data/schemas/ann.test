@Dialect=GOOGLE_STANDARD_SQL
CREATE TABLE Base (
  MyKey INT64 NOT NULL,
  MyData STRING(MAX),
  Embedding ARRAY<FLOAT32>(vector_length=>2),
  Embedding2 ARRAY<FLOAT32>(vector_length=>2),
  Embedding3 ARRAY<FLOAT64>(vector_length=>2),
) PRIMARY KEY(MyKey);
CREATE VECTOR INDEX vec_index ON Base(Embedding)
WHERE Embedding IS NOT NULL
OPTIONS(distance_type = 'COSINE', tree_depth = 2);
CREATE VECTOR INDEX vec_index_dot_product ON Base(Embedding)
WHERE Embedding IS NOT NULL
OPTIONS(distance_type = 'DOT_PRODUCT', tree_depth = 3);
CREATE VECTOR INDEX vec_index_euclidean ON Base(Embedding2)
WHERE Embedding2 IS NOT NULL
OPTIONS(distance_type = 'EUCLIDEAN', tree_depth = 2);
CREATE VECTOR INDEX vec_index_store ON Base(Embedding)
STORING (MyData)
WHERE Embedding IS NOT NULL
OPTIONS(distance_type = 'COSINE', tree_depth = 2);
CREATE VECTOR INDEX vec_index_double ON Base(Embedding3)
WHERE Embedding3 IS NOT NULL
OPTIONS(distance_type = 'COSINE', tree_depth = 2);
CREATE INDEX index2 ON Base(MyData);
===
@Dialect=POSTGRESQL
CREATE TABLE base (
  mykey bigint NOT NULL PRIMARY KEY,
  mydata varchar,
  embedding float4[] VECTOR LENGTH 2,
  embedding2 float4[] VECTOR LENGTH 2,
  embedding3 float8[] VECTOR LENGTH 2
);
CREATE INDEX vec_index ON base USING scann (embedding)
WITH (distance_type = 'COSINE', tree_depth = 2)
WHERE embedding IS NOT NULL;
CREATE INDEX vec_index_dot_product ON base USING scann (embedding)
WITH (distance_type = 'DOT_PRODUCT', tree_depth = 3, num_leaves = 10,
      num_branches = 2)
WHERE embedding IS NOT NULL;
CREATE INDEX vec_index_euclidean ON base USING scann (embedding2)
WITH (distance_type = 'EUCLIDEAN', tree_depth = 2)
WHERE embedding2 IS NOT NULL;
CREATE INDEX vec_index_store ON base USING scann (embedding)
INCLUDE (mydata)
WITH (distance_type = 'COSINE', tree_depth = 2)
WHERE embedding IS NOT NULL;
CREATE INDEX vec_index_double ON base USING scann (embedding3)
WITH (distance_type = 'COSINE', tree_depth = 2)
WHERE embedding3 IS NOT NULL;
CREATE INDEX index2 ON base(mydata);
